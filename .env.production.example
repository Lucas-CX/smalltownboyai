# Build configuration template for your own Worker. No provider secrets.
# Runtime bindings and live modes are in wrangler.production.example.jsonc.
# Deploy with pnpm cf:deploy, which loads .env.production.
VITE_APP_URL=https://example.com
VITE_SEO_URL=https://example.com
VITE_APP_NAME="Smalltown Boy AI"
VITE_SITE_INDEXABLE=false
VITE_PREVIEW_ONLY=true
DATABASE_PROVIDER=d1
DANCE_CLOUD_ENABLED=true
DANCE_PAYMENT_MODE=mock
DANCE_GENERATION_MODE=mock
