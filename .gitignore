/.wrangler/
wrangler.jsonc

# claude code local state
.claude/scheduled_tasks.lock

# production
/build

# deploy
.vercel

# editors (keep .cursor/skills — cross-agent symlink to .claude/skills)
.idea
.vscode
.cursor/*
!.cursor/skills

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — local files hold secrets, never commit (keep .env.example tracked)
.env
.dev.vars*
.env.*
!.env.example
!.env.production.example

# typescript
*.tsbuildinfo

# database
/data/
/drizzle/
src/config/db/schema.ts

# npm (project uses pnpm)
package-lock.json

# Runtime image uploads (no-storage local fallback)
/public/uploads/

# Generated delivery bundles, previews and verification logs
/output/
/.playwright-cli/

