{
  "name": "shipany-tanstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seo:preflight": "node scripts/seo-release-gate.mjs preflight",
    "seo:live": "node scripts/seo-release-gate.mjs live",
    "seo:gate:test": "node --test tests/seo-release-gate.test.mjs",
    "seo:test": "node tests/dance-seo.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "dev": "vite dev --port 3000",
    "prebuild": "node scripts/db-setup.mjs",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs",
    "postinstall": "node scripts/db-setup.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "tsx scripts/with-env.ts drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "tsx scripts/with-env.ts drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/with-env.ts drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "tsx scripts/with-env.ts drizzle-kit studio --config=drizzle.config.ts",
    "rbac:init": "tsx scripts/with-env.ts tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts tsx scripts/assign-role.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dance:worker": "tsx scripts/with-env.ts tsx scripts/dance-worker.ts",
    "dance:test": "tsx --test tests/dance-cast.test.ts tests/dance-live-payment.test.ts tests/dance-payment-journey.test.ts tests/dance-video-api.test.ts tests/dance.test.ts tests/dance-ledger.test.ts tests/dance-cloud-ledger.test.ts tests/dance-cloud-images.test.ts tests/auth-callback-url.test.ts tests/dance-reference.test.ts tests/dance-http.test.ts",
    "dance:funnel:test": "tsx --test tests/dance-funnel.test.ts tests/dance-analytics.test.ts tests/dance-payment-analytics.test.ts tests/dance-draft.test.ts tests/dance-photo.test.ts tests/dance-video.test.ts tests/dance-purchase-offer.test.ts tests/auth-callback-url.test.ts tests/auth-redirect.test.ts",
    "dance:conversion:test": "tsx --test tests/dance-conversion-evening.test.ts tests/dance-language-scope.test.ts tests/dance-analytics.test.ts tests/dance-payment-analytics.test.ts tests/dance-draft.test.ts tests/dance-photo.test.ts tests/dance-video.test.ts tests/dance-purchase-offer.test.ts tests/auth-callback-url.test.ts tests/auth-redirect.test.ts tests/clarity.test.ts tests/dance-funnel.test.ts tests/dance-video-preview.test.ts tests/browser-uuid.test.ts",
    "dance:fixture": "node scripts/make-dance-fixture.mjs",
    "setup:local": "node scripts/setup-workspace.mjs local",
    "setup:production": "node scripts/setup-workspace.mjs production"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,css,md,mdx,yaml,yml}": "prettier --write"
  },
